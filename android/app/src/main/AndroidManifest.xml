<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebView 引擎需要联网下载 foliate-js 远端资源时使用；纯本地模式亦无害 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="墨屏阅读"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true">

        <!-- 渲染后端：关掉 Impeller（Vulkan），改用 Skia。
             BOOX Note X3 Pro（Android 12）实测：从系统文件选择器选完 EPUB 回来的
             那一刻，Impeller 的 surface 重建失败，整屏黑且熄屏唤醒也不恢复，
             只能杀进程（同类报告：flutter/flutter#155973 "No surface available"）。
             墨水屏本来就没有动画，Skia 的兼容性收益远大于 Impeller 的性能收益。
             若以后确认稳定，想回到 Impeller 只需删掉这一项；也可只换后端：
             io.flutter.embedding.android.ImpellerBackend = "opengl"。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/LaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 支持「发送到」打开文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
